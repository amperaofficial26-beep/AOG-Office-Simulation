# Salin berkas ini menjadi .streamlit/secrets.toml lalu isi kunci Anda.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# Kunci juga bisa diisi dari panel Pengaturan di dalam aplikasi.

GROQ_API_KEY = "gsk_..."
OPENROUTER_API_KEY = "sk-or-v1-..."
AION_API_KEY = "aion_..."
GITHUB_TOKEN = "github_pat_..."   # opsional: membuka integrasi GitHub live

# Karyawan Ruang AI Image — Cloudflare Workers AI (FLUX.1 Schnell/Dev).
# Buat token di Cloudflare Dashboard > My Profile > API Tokens dengan izin
# "Workers AI: Edit". Account id boleh dikosongkan: aplikasi mencari akun
# pertama yang bisa diakses token tersebut.
CLOUDFLARE_API_KEY = "cf_..."
CLOUDFLARE_ACCOUNT_ID = ""        # opsional: 32 karakter hex

# Karyawan Ruang Web Research — Tavily Search (riset web bersumber).
# Ambil kunci di https://app.tavily.com (1.000 kredit/bulan gratis).
TAVILY_API_KEY = "tvly-..."
